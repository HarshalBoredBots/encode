TG_BOT_TOKEN=your_bot_token
APP_ID=12345678
API_HASH=your_api_hash
LOG_CHANNEL=-1001234567890
OWNER_ID=123456789
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/
DATABASE_NAME=EncoderBot
BOT_NAME=Encoder Bot
BOT_VERSION=1.0.0
PORT=8080
MAX_CONCURRENT_JOBS=1

# ── FFmpeg threading ────────────────────────────────────────────────────────
# Keep at 1 or 2 on Heroku 1 GB dynos.
# SVT-AV1 at 1080p: use FFMPEG_THREADS=1 (single LP) to stay under 1 GB RAM.
# SVT-AV1 at 480p/720p: FFMPEG_THREADS=2 is safe.
# x265: FFMPEG_THREADS=2 with lookahead-slices=0 (already applied in code).
FFMPEG_THREADS=1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
